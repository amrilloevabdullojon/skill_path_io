{
  "name": "levio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "prestart": "node scripts/check-env.mjs",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "check:env": "node scripts/check-env.mjs",
    "check:env:prod": "node scripts/check-env.mjs --prod",
    "check:release": "npm run check:env:prod && npm run lint && npm run typecheck && npm run test && npm run build && npm audit --omit=dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "check:local": "npm run check:env && npm run lint && npm run typecheck && npm run test && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "prepare": "husky"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "5.22.0",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.6",
    "framer-motion": "^12.36.0",
    "jose": "^6.2.3",
    "lucide-react": "0.468.0",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "rehype-highlight": "^7.0.2",
    "tailwind-merge": "2.5.4",
    "uuid": "11.1.1",
    "zod": "^3.25.76",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.1",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.0.11",
    "jsdom": "^29.0.1",
    "lint-staged": "^15.2.2",
    "postcss": "^8.5.15",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.14",
    "tailwindcss-animate": "1.0.7",
    "tsx": "^4.22.3",
    "typescript": "5.6.3",
    "vitest": "^4.1.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "sh -c 'npm run typecheck'"
    ]
  },
  "overrides": {
    "dompurify": "3.4.6",
    "postcss": "$postcss",
    "uuid": "11.1.1"
  }
}
